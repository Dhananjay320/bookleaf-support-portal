# Copy to .env and fill in. Never commit .env.

# Anthropic API key (server-side only). Leave empty to run with rule-based fallbacks.
ANTHROPIC_API_KEY=

# Models (optional). Defaults to claude-opus-5-5 for both.
# claude-haiku-5-5 is a cheaper drop-in for classification at high ticket volumes.
AI_CLASSIFY_MODEL=claude-opus-5-5
AI_DRAFT_MODEL=claude-opus-5-5

# Required in production: a long random string used to sign session tokens.
JWT_SECRET=

PORT=4000
# DATABASE_PATH=./data/bookleaf.db
# Only needed if the frontend is hosted on a different origin:
# CORS_ORIGIN=http://localhost:5173
