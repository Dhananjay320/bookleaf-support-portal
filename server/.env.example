# Copy to .env and fill in. Never commit .env.

# --- AI provider -------------------------------------------------------------
# "gemini" or "anthropic". If unset, the first provider with a key is used (Gemini, then Anthropic).
# With no key at all the app still works, using rule-based triage and reply templates.
AI_PROVIDER=gemini

# Google Gemini (free tier available at https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# GEMINI_CLASSIFY_MODEL=gemini-2.5-flash
# GEMINI_DRAFT_MODEL=gemini-2.5-flash

# Anthropic Claude (optional alternative)
ANTHROPIC_API_KEY=
# AI_CLASSIFY_MODEL=claude-opus-5-5
# AI_DRAFT_MODEL=claude-opus-5-5

# --- Server ------------------------------------------------------------------
# Required in production: a long random string used to sign session tokens.
JWT_SECRET=

PORT=4000
# DATABASE_PATH=./data/bookleaf.db
# Only needed if the frontend is hosted on a different origin:
# CORS_ORIGIN=http://localhost:5173
